# Copy to .env (npm run init-env) and fill in. NEVER commit .env or real values.
# .env, credentials, browser profiles, and run artifacts are git-ignored.

# --- Google Sheets (service account, unattended) ---------------------------
# Absolute path to a service-account JSON key file kept OUTSIDE this repo.
# Share the target Sheet with the service account's client_email (Editor).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
# Spreadsheet id (the long id in the Sheet URL). Persona.sheet_id overrides this.
GOOGLE_SHEET_ID=

# --- Persona ---------------------------------------------------------------
# Active persona slug (file under private/personas/<slug>.yaml).
# save-persona selects one for you, so this usually stays empty.
AIDGENT_PERSONA=

# --- LinkedIn session ------------------------------------------------------
# EITHER of the two below is enough. The cookie is the simplest: in a browser
# where you are signed into LinkedIn, open DevTools > Application > Cookies >
# https://www.linkedin.com and copy the value of the cookie named `li_at`.
# Treat it like a password. With only this set, runs are headless from the
# first one and no login window ever opens. Verify with: npm run check-login
AIDGENT_LI_AT=

# --- Local Chrome profile (dedicated, signed-in manually) ------------------
# A persistent Chrome user-data dir OUTSIDE this repo. It holds auth cookies,
# so treat it like a credential. Sign in once with: npm run setup-login
#
# The value below is a DESCRIPTION, not a path. Every command refuses to run
# while it is still here, on purpose: Chrome creates any profile folder it is
# given, so a made-up path opens a brand-new signed-out browser and the run
# stops at a LinkedIn login page — which looks like LinkedIn blocking you
# rather than a line you never filled in. Replace it with a real folder.
# Forward slashes work on Windows and cannot be mistaken for escapes:
#   AIDGENT_CHROME_PROFILE=C:/Users/<your-windows-username>/aidgent-chrome-profile
#
# Set it HERE rather than in your terminal: only this file is read by the next
# command. setup-login and check-login write the proven value here themselves.
AIDGENT_CHROME_PROFILE=/absolute/path/outside/repo/aidgent-chrome-profile
# Installed Chrome channel to drive (chrome | chrome-beta | msedge).
AIDGENT_CHROME_CHANNEL=chrome

# --- Safety rails ----------------------------------------------------------
# Daily budgets, persisted across invocations in private/budget-state.json.
# `open` and `inspect` both consume; exhausted budgets refuse until midnight.
AIDGENT_OPEN_BUDGET=120
AIDGENT_INSPECT_BUDGET=60
# Pacing bounds between navigations (ms). Do not shorten to make a number.
AIDGENT_MIN_DELAY_MS=3500
AIDGENT_MAX_DELAY_MS=9000
