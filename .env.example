# Copy to .env with `npm run init-env`, then fill in local values.
# Never commit .env, credentials, tokens, personas, or run artifacts.

# Absolute path to a Google service-account JSON key kept outside this repo.
# Share the target Sheet with the key's client_email as Editor.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repo/service-account.json

# The spreadsheet id from the user's own Sheet copy.
GOOGLE_SHEET_ID=

# Selected file slug under private/personas/. save-persona normally sets this.
AIDGENT_PERSONA=

# Apify Console > Settings > Integrations. Treat this like a password.
APIFY_API_TOKEN=

# Recent LinkedIn post enrichment.
AIDGENT_APIFY_ACTOR=harvestapi~linkedin-profile-posts
AIDGENT_APIFY_MAX_POSTS=3
AIDGENT_APIFY_LOOKBACK=month
AIDGENT_APIFY_BATCH_SIZE=20
